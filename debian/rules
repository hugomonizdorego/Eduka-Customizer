#!/usr/bin/make -f

%:
	dh $@

override_dh_auto_build:
	$(MAKE) check

override_dh_auto_test:
ifeq (,$(filter nocheck,$(DEB_BUILD_OPTIONS)))
	python3 -m pytest -q tests
endif

override_dh_auto_install:
	$(MAKE) install DESTDIR=$(CURDIR)/debian/distroforge PREFIX=/usr
	# Documentation and screenshots for developers who try the package.
	install -d $(CURDIR)/debian/distroforge/usr/share/doc/distroforge/screenshots
	install -m644 README.md CHANGELOG.md docs/manual.md docs/PANDUAN.md docs/ROADMAP.md \
		$(CURDIR)/debian/distroforge/usr/share/doc/distroforge/
	install -m644 docs/screenshots/*.png $(CURDIR)/debian/distroforge/usr/share/doc/distroforge/screenshots/

# The package is not compressed: whatever its size, it is built as it is.
override_dh_builddeb:
	dh_builddeb -- -Znone

# Keep the icons, screenshots and documentation exactly as they are.
override_dh_compress:
	dh_compress -X.md -X.png -X.svg
