{
  "name": "Edukasaun OS 1.0 - school edition",
  "comment": "Apply with: sudo eduka-customizer -p PROJECT recipe apply edukasaun-school.json",
  "steps": [
    {"action": "sources", "suite": "stable", "backports": false},
    {"action": "apt-upgrade"},
    {"action": "identity", "name": "Edukasaun OS", "version": "1.0", "codename": "Kameli",
     "id": "edukasaun", "hostname": "edukasaun", "live_user": "eduka",
     "live_fullname": "Edukasaun Live User", "volume_label": "EDUKASAUN_OS_1_0"},
    {"action": "locale", "default": "pt_PT.UTF-8", "extra": ["en_US.UTF-8", "id_ID.UTF-8"],
     "timezone": "Asia/Dili", "keyboard": "pt"},
    {"action": "desktop", "id": "eduka", "dm": "lightdm"},
    {"action": "eduka-desktop", "install": false,
     "panel": {"height": 44, "theme_style": "Eduka-Default-Theme", "menu_label": "Edukasaun"},
     "desktop": {"layout": "Grid"}},
    {"action": "apt-install", "packages": ["calamares-settings-debian", "libreoffice", "libreoffice-l10n-pt",
                                           "firefox-esr", "vlc", "gimp", "orca"]},
    {"action": "flatpak", "apps": ["org.kde.gcompris", "org.geogebra.GeoGebra", "org.stellarium.Stellarium"],
     "firstboot": true},
    {"action": "boot", "extra_params": "quiet splash", "timeout": 10},
    {"action": "build", "options": {"compression": "zstd", "level": 15}}
  ]
}
