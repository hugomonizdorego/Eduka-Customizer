# Paths excluded from live/filesystem.squashfs (mksquashfs -wildcards -ef).
# Paths are relative to the root filesystem. Lines starting with '#' are comments.
# Based on the exclusion lists of remastersys and penguins-eggs.

# Pseudo and temporary filesystems
dev/*
proc/*
sys/*
run/*
tmp/*
tmp/.*
var/tmp/*
mnt/*
media/*
lost+found
swapfile
swap.img

# Chroot helpers
etc/resolv.conf.eduka-backup
usr/sbin/policy-rc.d.eduka

# Machine specific data
etc/fstab.d/*
etc/crypttab
etc/adjtime
etc/udev/rules.d/70-persistent-cd.rules
etc/udev/rules.d/70-persistent-net.rules
etc/X11/xorg.conf
etc/NetworkManager/system-connections/*
var/lib/NetworkManager/secret_key
var/lib/systemd/random-seed
var/lib/dbus/machine-id
boot/efi/EFI
boot/grub/grub.cfg
boot/grub/grubenv

# Caches
var/cache/apt/archives/*.deb
var/cache/apt/archives/partial/*
var/cache/apt/*.bin
var/cache/debconf/*-old
var/lib/dpkg/*-old
var/cache/lightdm
var/lib/lightdm/.cache
var/lib/lightdm/.Xauthority
var/tmp/flatpak-cache-*

# Containers and sandboxes
var/lib/docker
var/lib/containerd
var/lib/containers
var/lib/lxc
var/lib/lxd
var/lib/machines
var/lib/snapd
snap

# User leftovers
root/.bash_history
root/.cache
root/.eduka_history
etc/skel/.cache
etc/skel/.xsession-errors
etc/skel/.Xauthority
