  ],
  [
   "breeze",
   "sddm-theme-breeze"
  ],
  [
   "maui",
   "sddm-theme-maui"
  ],
  [
   "elarun",
   "sddm-theme-elarun"
  ],
  [
   "maldives",
   "sddm-theme-maldives"
  ],
  [
   "debian-maui",
   "sddm-theme-debian-maui"
  ],
  [
   "debian-elarun",
   "sddm-theme-debian-elarun"
  ]
 ],
 "compositors": [
  {
   "id": "none",
   "name": "No compositor",
   "kind": "x11",
   "description": "Fastest, no transparency or shadows."
  },
  {
   "id": "picom",
   "name": "picom",
   "kind": "x11",
   "packages": [
    "picom"
   ],
   "description": "Shadows, fading, transparency and blur for any X11 desktop (needed by Eduka-Desktop Liquid Glass blur)."
  },
  {
   "id": "xcompmgr",
   "name": "xcompmgr",
   "kind": "x11",
   "packages": [
    "xcompmgr"
   ],
   "description": "Very light compositor: simple transparency."
  },
  {
   "id": "builtin",
   "name": "Built-in of the desktop (automatic)",
   "kind": "x11",
   "description": "The desktop's own compositor: xfwm4, KWin, Mutter, Marco, Muffin or Budgie's."
  },
  {
   "id": "labwc",
   "name": "labwc",
   "kind": "wayland",
   "packages": [
    "labwc"
   ],
   "description": "Openbox-like Wayland compositor (LXQt Wayland default)."
  },
  {
   "id": "kwin_wayland",
   "name": "KWin",
   "kind": "wayland",
   "packages": [
    "kwin-wayland"
   ],
   "description": "KDE's compositor, rich effects."
  },
  {
   "id": "wayfire",
   "name": "Wayfire",
   "kind": "wayland",
   "packages": [
    "wayfire"
   ],
   "description": "3D effects Wayland compositor."
  },
  {
   "id": "sway",
   "name": "Sway",
   "kind": "wayland",
   "packages": [
    "sway"
   ],
   "description": "Tiling Wayland compositor."
  },
  {
   "id": "xfwm4",
   "name": "xfwm4 (Xfce built-in)",
   "kind": "native",
   "desktop": "xfce",
   "description": "Xfce's own window manager composites: shadows and transparency without picom."
  },
  {
   "id": "kwin",
   "name": "KWin (KDE built-in)",
   "kind": "native",
   "desktop": "kde",
   "description": "KDE Plasma's own compositor. picom must not run next to it."
  },
  {
   "id": "mutter",
   "name": "Mutter (GNOME built-in)",
   "kind": "native",
   "desktop": "gnome",
   "description": "GNOME always composites with Mutter. picom must not run next to it."
  },
  {
   "id": "marco",
   "name": "Marco (MATE built-in)",
   "kind": "native",
   "desktop": "mate",
   "description": "MATE's own window manager composites (shadows, transparency)."
  },
  {
   "id": "muffin",
   "name": "Muffin (Cinnamon built-in)",
   "kind": "native",
   "desktop": "cinnamon",
   "description": "Cinnamon always composites with Muffin. picom must not run next to it."
  },
  {
   "id": "budgie-wm",
   "name": "Budgie window manager (built-in)",
   "kind": "native",
   "desktop": "budgie",
   "description": "Budgie always composites with its own window manager."
  }
 ],
 "picom_presets": [
  "light",
  "shadows",
  "glass",
  "off"
 ]
}
