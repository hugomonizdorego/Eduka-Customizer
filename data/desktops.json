  "display_managers": [
    {"id": "lightdm", "name": "LightDM (GTK greeter)", "packages": ["lightdm", "lightdm-gtk-greeter"], "binary": "/usr/sbin/lightdm"},
    {"id": "lightdm-slick", "name": "LightDM (Slick greeter)", "packages": ["lightdm", "slick-greeter"], "binary": "/usr/sbin/lightdm", "service": "lightdm"},
    {"id": "sddm", "name": "SDDM", "packages": ["sddm"], "binary": "/usr/bin/sddm"},
    {"id": "gdm3", "name": "GDM", "packages": ["gdm3"], "binary": "/usr/sbin/gdm3"},
    {"id": "lxdm", "name": "LXDM", "packages": ["lxdm"], "binary": "/usr/sbin/lxdm"}
  ],
  "window_managers_for_lxqt": ["openbox", "xfwm4", "kwin-x11", "labwc"]
