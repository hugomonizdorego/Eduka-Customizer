{
 "desktops": [
  {
   "id": "eduka",
   "name": "Eduka-Desktop",
   "kind": "de",
   "description": "Edukasaun OS desktop: Eduka-Panel and Eduka-Menu on top of LXQt. Light, accessible and made for schools.",
   "packages": [
    "lxqt-core",
    "lxqt-session",
    "openbox",
    "pcmanfm-qt",
    "qterminal",
    "featherpad",
    "lximage-qt",
    "pavucontrol-qt",
    "network-manager-gnome",
    "papirus-icon-theme",
    "xorg"
   ],
   "eduka_desktop": true,
   "session": "edukasaun-desktop",
   "dm": "lightdm",
   "task": "",
   "sessions": {
    "x11": "edukasaun-desktop"
   },
   "recommended_compositor": "picom"
  },
  {
   "id": "lxqt",
   "name": "LXQt",
   "kind": "de",
   "description": "Lightweight Qt desktop (base of Eduka-Desktop).",
   "packages": [
    "task-lxqt-desktop"
   ],
   "session": "lxqt",
   "dm": "sddm",
   "task": "task-lxqt-desktop",
   "sessions": {
    "x11": "lxqt",
    "wayland": "lxqt-wayland",
    "wayland_packages": [
     "lxqt-wayland-session",
     "labwc"
    ]
   },
   "recommended_compositor": "picom"
  },
  {
   "id": "xfce",
   "name": "Xfce",
   "kind": "de",
   "description": "Fast, traditional GTK desktop.",
   "packages": [
    "task-xfce-desktop"
   ],
   "session": "xfce",
   "dm": "lightdm",
   "task": "task-xfce-desktop",
   "sessions": {
    "x11": "xfce"
   },
   "native_compositor": "xfwm4",
   "always_composited": false
  },
  {
   "id": "kde",
   "name": "KDE Plasma",
   "kind": "de",
   "description": "Full-featured, modern Qt desktop.",
   "packages": [
    "task-kde-desktop"
   ],
   "session": "plasma",
   "dm": "sddm",
   "task": "task-kde-desktop",
   "sessions": {
    "x11": "plasmax11",
    "wayland": "plasma",
    "x11_packages": [
     "plasma-session-x11"
    ]
   },
   "native_compositor": "kwin",
   "always_composited": true
  },
  {
   "id": "gnome",
   "name": "GNOME",
   "kind": "de",
   "description": "Debian's default desktop. Needs more RAM.",
   "packages": [
    "task-gnome-desktop"
   ],
   "session": "gnome",
   "dm": "gdm3",
   "task": "task-gnome-desktop",
   "sessions": {
    "x11": "gnome-xorg",
    "wayland": "gnome"
   },
   "native_compositor": "mutter",
   "always_composited": true
  },
  {
   "id": "mate",
   "name": "MATE",
   "kind": "de",
   "description": "Classic GNOME 2 style desktop.",
   "packages": [
    "task-mate-desktop"
   ],
   "session": "mate",
   "dm": "lightdm",
   "task": "task-mate-desktop",
   "sessions": {
    "x11": "mate"
   },
   "native_compositor": "marco",
   "always_composited": false
  },
  {
   "id": "cinnamon",
   "name": "Cinnamon",
   "kind": "de",
   "description": "Familiar desktop from Linux Mint.",
   "packages": [
    "task-cinnamon-desktop"
   ],
   "session": "cinnamon",
   "dm": "lightdm",
   "task": "task-cinnamon-desktop",
   "sessions": {
    "x11": "cinnamon",
    "wayland": "cinnamon-wayland"
   },
   "native_compositor": "muffin",
   "always_composited": true
  },
  {
   "id": "lxde",
   "name": "LXDE",
   "kind": "de",
   "description": "Very light GTK2 desktop for old computers.",
   "packages": [
    "task-lxde-desktop"
   ],
   "session": "LXDE",
   "dm": "lightdm",
   "task": "task-lxde-desktop",
   "sessions": {
    "x11": "LXDE"
   },
   "recommended_compositor": "picom"
  },
  {
