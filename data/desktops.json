 "display_managers": [
  {
   "id": "lightdm",
   "name": "LightDM - GTK greeter",
   "description": "Light and simple, themable with GTK themes. Good default.",
   "packages": [
    "lightdm",
    "lightdm-gtk-greeter",
    "lightdm-gtk-greeter-settings"
   ],
   "binary": "/usr/sbin/lightdm",
   "service": "lightdm",
   "greeter": "lightdm-gtk-greeter"
  },
  {
   "id": "lightdm-slick",
   "name": "LightDM - Slick greeter",
   "description": "Modern full-screen greeter (Linux Mint style).",
   "packages": [
    "lightdm",
    "slick-greeter",
    "lightdm-settings"
   ],
   "binary": "/usr/sbin/lightdm",
   "service": "lightdm",
   "greeter": "slick-greeter"
  },
  {
   "id": "lightdm-arctica",
   "name": "LightDM - Arctica greeter",
   "description": "Elegant greeter with large user list.",
   "packages": [
    "lightdm",
    "arctica-greeter"
   ],
   "binary": "/usr/sbin/lightdm",
   "service": "lightdm",
   "greeter": "arctica-greeter"
  },
  {
   "id": "lightdm-kde",
   "name": "LightDM - KDE greeter",
   "description": "Qt/KDE style greeter for LightDM.",
   "packages": [
    "lightdm",
    "lightdm-kde-greeter"
   ],
   "binary": "/usr/sbin/lightdm",
   "service": "lightdm",
   "greeter": "lightdm-kde-greeter"
  },
  {
   "id": "sddm",
   "name": "SDDM",
   "description": "Qt login manager (KDE, LXQt). Choose a theme below.",
   "packages": [
    "sddm"
   ],
   "binary": "/usr/bin/sddm",
   "service": "sddm"
  },
  {
   "id": "gdm3",
   "name": "GDM",
   "description": "GNOME's login manager, Wayland by default.",
   "packages": [
    "gdm3"
   ],
   "binary": "/usr/sbin/gdm3",
   "service": "gdm3"
  },
  {
   "id": "lxdm",
   "name": "LXDM",
   "description": "Very light login manager.",
   "packages": [
    "lxdm"
   ],
   "binary": "/usr/sbin/lxdm",
   "service": "lxdm"
  },
  {
   "id": "ly",
   "name": "Ly (console)",
   "description": "Text-mode login manager for minimal systems.",
   "packages": [
    "ly"
   ],
   "binary": "/usr/bin/ly",
   "service": "ly"
  },
  {
   "id": "greetd",
   "name": "greetd + tuigreet",
   "description": "Minimal greeter daemon, good for Wayland compositors.",
   "packages": [
    "greetd",
    "tuigreet"
   ],
   "binary": "/usr/sbin/greetd",
   "service": "greetd"
  }
 ],
 "window_managers_for_lxqt": [
  "openbox",
  "xfwm4",
  "kwin-x11",
  "labwc"
 ],
