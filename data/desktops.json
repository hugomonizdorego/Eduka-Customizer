   "dm": "lightdm",
   "sessions": {
    "x11": "i3"
   }
  },
  {
   "id": "fluxbox",
   "name": "Fluxbox",
   "kind": "wm",
   "description": "Light stacking window manager.",
   "packages": [
    "fluxbox",
    "xorg"
   ],
   "session": "fluxbox",
   "dm": "lightdm",
   "sessions": {
    "x11": "fluxbox"
   },
   "recommended_compositor": "picom"
  },
  {
   "id": "icewm",
   "name": "IceWM",
