[Desktop Entry]
Type=Application
Name=Eduka-Customizer
GenericName=ISO Builder
Comment=Build and customize live ISO images of Debian-based distributions
Comment[id]=Bangun dan kustomisasi image ISO live distribusi berbasis Debian
Comment[pt]=Criar e personalizar imagens live de distribuições baseadas em Debian
Exec=@PREFIX@/bin/eduka-customizer-pkexec %f
Icon=eduka-customizer
Terminal=false
Categories=System;Settings;Development;
Keywords=iso;remaster;live;debian;distro;cubic;customizer;
MimeType=application/x-cd-image;application/x-iso9660-image;
StartupNotify=true
StartupWMClass=eduka-customizer
